---
export interface Props {
  album_id?: string;
  track_id?: string;
  title: string;
  url: string;
  size?: 'small' | 'large';
}

const { 
  album_id, 
  track_id, 
  title, 
  url, 
  size = album_id ? 'large' : 'small' 
} = Astro.props;

// Noir Stage Colors
const bgcol = '131313';
const linkcol = 'e4b5ff'; // --accent-purple
---

<div class={`bandcamp-noir-frame ${size}`}>
  {album_id ? (
    <iframe 
      style={`border: 0; width: 100%; height: ${size === 'large' ? '470px' : '120px'};`} 
      src={`https://bandcamp.com/EmbeddedPlayer/album=${album_id}/size=${size}/bgcol=${bgcol}/linkcol=${linkcol}/tracklist=false/transparent=true/`} 
      seamless 
      loading="lazy" 
      decoding="async"
    >
      <a href={url}>{title}</a>
    </iframe>
  ) : track_id ? (
    <iframe 
      style="border: 0; width: 100%; height: 120px;" 
      src={`https://bandcamp.com/EmbeddedPlayer/track=${track_id}/size=large/bgcol=${bgcol}/linkcol=${linkcol}/tracklist=false/artwork=small/transparent=true/`} 
      seamless 
      loading="lazy" 
      decoding="async"
    >
      <a href={url}>{title}</a>
    </iframe>
  ) : null}
</div>

<style>
  .bandcamp-noir-frame {
    position: relative;
    background: var(--surface-container-lowest, #0e0e0e);
    box-shadow: 0 40px 80px rgba(89, 0, 137, 0.08); /* Tinted shadow (purple container) */
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
    overflow: hidden;
  }

  .bandcamp-noir-frame:hover {
    transform: translateY(-5px) scale(1.01);
    box-shadow: 0 60px 100px rgba(89, 0, 137, 0.12);
  }

  .large {
    max-width: 700px;
    margin: 40px auto;
  }

  .small {
    max-width: 700px;
    margin: 20px auto;
  }
</style>