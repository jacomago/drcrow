---
import Layout from './Layout.astro';
import PageHero from '../components/PageHero.astro';
import { Image, getImage } from 'astro:assets';
import galleryHighlights from '../data/gallery_highlights.json';
import galleryArchive from '../data/gallery_archive.json';
const { frontmatter } = Astro.props;

// Import all images from the assets directory
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpeg,jpg,png,gif}');

// Pre-calculate optimized versions for zoom
const highlightsWithZoom = await Promise.all(
  galleryHighlights.items.map(async (img) => {
    const path = `/src/assets/images/highlights/${img}`;
    if (!images[path]) return null;
    const thumb = images[path]();
    const zoom = await getImage({ src: thumb, width: 1600 });
    return { path, thumb, zoom: zoom.src };
  })
);

const archiveWithZoom = await Promise.all(
  galleryArchive.items.map(async (img) => {
    const path = `/src/assets/images/archive/${img}`;
    if (!images[path]) return null;
    const thumb = images[path]();
    const zoom = await getImage({ src: thumb, width: 1200 });
    return { path, thumb, zoom: zoom.src };
  })
);
---
<Layout title={frontmatter.title}>
  <PageHero title={frontmatter.title} tagline={frontmatter.lead} image={frontmatter.image} />
  <section class="gallery-content bg-surface-low">
    <div class="container">
      <slot />
      <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; letter-spacing: 0.3em; margin-bottom: 2rem; color: var(--accent-gold);">MANIFESTATIONS</h2>
      <div class="gallery-grid">
        {highlightsWithZoom.map(item => item && (
          <div class="gallery-item">
            <Image 
              src={item.thumb} 
              alt="Forbidden Zone Manifestation" 
              width={800} 
              height={600} 
              loading="lazy" 
              decoding="async" 
              data-zoom={item.zoom}
            />
          </div>
        ))}
      </div>
      <h2 style="font-family: 'Space Grotesk', sans-serif; font-size: 1.5rem; letter-spacing: 0.3em; margin-top: 6rem; margin-bottom: 2rem; color: var(--accent-gold);">THE ARCHIVE</h2>
      <div class="gallery-grid" style="grid-template-columns: repeat(8, 1fr);">
        {archiveWithZoom.map(item => item && (
          <div class="gallery-item" style="grid-column: span 2; box-shadow: 0 10px 20px rgba(0,0,0,0.5);">
            <Image 
              src={item.thumb} 
              alt="Forbidden Zone Archive" 
              width={400} 
              height={300} 
              loading="lazy" 
              decoding="async" 
              style="height: 250px; object-fit: cover;" 
              data-zoom={item.zoom}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>